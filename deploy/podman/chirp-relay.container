# The Chirp relay as a systemd service, through Podman Quadlet.
#
# Install (docs/relay.md, "Podman"), together with caddy.container:
#
#   rootful:   /etc/containers/systemd/
#   rootless:  ~/.config/containers/systemd/
#
# then `systemctl [--user] daemon-reload && systemctl [--user] start caddy`.
#
# The image is built locally from deploy/container/Containerfile and tagged
# localhost/chirp-relay:latest; Chirp publishes no image of its own yet.
#
# SPDX-License-Identifier: AGPL-3.0-only
# Copyright (C) 2026 Fabrintek Engenharia Digital Ltda

[Unit]
Description=Chirp relay
Documentation=https://github.com/barahn/chirp/blob/main/docs/relay.md

[Container]
ContainerName=chirp-relay
Image=localhost/chirp-relay:latest

# No network at all. The relay listens on a Unix socket in a volume that only
# this container and caddy.container mount, so Caddy is the only way in, and
# nothing else on the host can pose as Caddy (docs/relay.md, "How the pieces
# connect"). The relay believes the X-Forwarded-For on every request it
# receives there.
Network=none
Volume=chirp-relay-socket:/run/chirp-relay:U
Environment=CHIRP_RELAY_ADDR=unix:/run/chirp-relay/relay.sock
# Caddy's container runs as a different user with every capability dropped,
# so the socket is open to all. The volume is the boundary: it is reachable
# only by the two containers and by whoever owns them.
Environment=CHIRP_RELAY_SOCKET_MODE=0666

# The image has no shell, so the check runs the binary directly (exec form).
HealthCmd=["/usr/local/bin/chirp-relay","-healthcheck"]
HealthInterval=30s
HealthTimeout=5s
HealthRetries=3
HealthOnFailure=kill

# The relay keeps all its state in memory and writes nothing.
ReadOnly=true
DropCapability=ALL
NoNewPrivileges=true
User=65532
Group=65532

[Service]
Restart=always
RestartSec=2
TimeoutStopSec=15

[Install]
WantedBy=default.target
