# /etc/chirp-status/status.env -- the status service's settings, read by
# chirp-status.service. deploy/status/install.sh writes it once and never
# overwrites it. After changing it: systemctl restart chirp-status
#
# SPDX-License-Identifier: AGPL-3.0-only
# Copyright (C) 2026 Fabrintek Engenharia Digital Ltda

# Where the API listens. Loopback: the TLS proxy or tunnel that publishes it
# runs on this machine.
CHIRP_STATUS_ADDR=127.0.0.1:8081

# The network's servers, a copy of network/servers.json from the repository.
CHIRP_STATUS_SERVERS=/etc/chirp-status/servers.json

# The probes. The state directory systemd gives the service.
CHIRP_STATUS_DB=/var/lib/chirp-status/status.db

# A name for where this machine probes from, shown on the status page:
# a city, a provider, a region. Never the address of the machine.
CHIRP_STATUS_VANTAGE=primary

# The one origin whose pages may read the API: the status page's.
CHIRP_STATUS_ALLOW_ORIGIN=https://usechirp.app
