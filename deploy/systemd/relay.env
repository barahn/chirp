# /etc/chirp-relay/relay.env -- the Chirp relay's settings, read by
# chirp-relay.service. deploy/install.sh writes it once and never overwrites
# it. After changing it: systemctl restart chirp-relay
#
# SPDX-License-Identifier: AGPL-3.0-only
# Copyright (C) 2026 Fabrintek Engenharia Digital Ltda

# Where the relay listens. A Unix socket when Caddy runs on the same machine,
# which is the layout deploy/install.sh sets up: only the chirp-relay group,
# which Caddy is in, can open it, so the relay believes the X-Forwarded-For
# on every request it receives there.
CHIRP_RELAY_ADDR=unix:/run/chirp-relay/relay.sock
CHIRP_RELAY_SOCKET_MODE=0660

# If the TLS proxy runs elsewhere (another container, the Proxmox host),
# listen on TCP instead, on the address that proxy reaches, let the firewall
# admit only the proxy, and name it here: addresses or CIDRs, comma-separated,
# whose X-Forwarded-For the relay believes. Never list a range that anything
# but your proxies can connect from (docs/relay.md, "Behind a proxy you
# already run").
#CHIRP_RELAY_ADDR=10.10.10.20:8080
#CHIRP_RELAY_TRUSTED_PROXIES=10.10.10.1

# Where to report a security problem with this relay, served as
# /.well-known/security.txt: an email address or an https: URL. Without it,
# the relay serves no security.txt.
#CHIRP_RELAY_SECURITY_CONTACT=security@example.org
