# /etc/chirp-relay/relay.env -- the Chirp relay's settings, read by
# chirp-relay.service. deploy/install.sh writes it once and never overwrites
# it. After changing it: systemctl restart chirp-relay
#
# SPDX-License-Identifier: AGPL-3.0-only
# Copyright (C) 2026 Fabrintek Engenharia Digital Ltda

# Where the relay listens. Loopback when Caddy runs on the same machine, which
# is the layout deploy/install.sh sets up. If the TLS proxy runs elsewhere
# (another container, the Proxmox host), listen on the address that proxy
# reaches, and let the firewall admit only the proxy.
CHIRP_RELAY_ADDR=127.0.0.1:8080

# The reverse proxies whose X-Forwarded-For header the relay believes:
# addresses or CIDRs, comma-separated. Name exactly the proxies in front of
# the relay. Empty means none: every request is counted against the address
# it arrived from, which behind a proxy makes all users share one throttle.
# Never put a range here that clients can connect from.
CHIRP_RELAY_TRUSTED_PROXIES=127.0.0.1,::1
